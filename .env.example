# ─────────────────────────────────────────────────────────────
#  VeritasAgent — plantilla de variables de entorno
#  Copia este archivo a .env y rellena los valores reales.
#  NUNCA subas el .env real al repositorio.
# ─────────────────────────────────────────────────────────────

# ─── Vertex AI (Gemini) ──────────────────────────────────────
# La autenticación NO usa API key (la organización las bloquea).
# Se hace con Application Default Credentials (ADC). Antes de correr:
#     gcloud auth login
#     gcloud auth application-default login
#     gcloud config set project hackaton-498600
#     gcloud auth application-default set-quota-project hackaton-498600
PROJECT_ID=hackaton-498600
GOOGLE_CLOUD_PROJECT=hackaton-498600
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# Modelos
MODEL_ID=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# ─── Agent Engine (cuando esté desplegado, Fase 6) ───────────
AGENT_ENGINE_ID=

# ─── Bright Data MCP (scraping + búsqueda web anti-bot) ──────
# Servidor MCP oficial @brightdata/mcp (vía npx). Solo requiere el API token.
# Obtén el token en: https://brightdata.com/cp/setting/users
BRIGHTDATA_API_KEY=tu_api_token_de_brightdata

# ─── Bright Data Scraping Browser (opcional, modo Playwright/CDP) ──
BRIGHT_DATA_WS_URL=wss://USER:PASS@brd.superproxy.io:9222

# ─── Brave Search ────────────────────────────────────────────
BRAVE_API_KEY=

# ─── Elasticsearch (triage + memoria) ────────────────────────
# Opción A: Elastic Cloud (gestionado)
ELASTIC_CLOUD_ID=
# Opción B: Elastic self-hosted / local
ELASTIC_URL=https://localhost:9200
ELASTIC_API_KEY=
ELASTIC_INDEX=verified_claims
# Imagen del servidor MCP oficial de Elasticsearch (toolset del agente).
# Requiere Docker en ejecución. Usa ELASTIC_URL + ELASTIC_API_KEY.
ELASTIC_MCP_IMAGE=docker.elastic.co/mcp/elasticsearch

# ─── API backend ─────────────────────────────────────────────
API_URL=http://localhost:8080

# ─── Configuración del agente ────────────────────────────────
# Umbrales del triage (ver PLAN.md §3)
TRIAGE_EARLY_EXIT_THRESHOLD=0.92
TRIAGE_EVIDENCE_THRESHOLD=0.75
# Días tras los cuales una verificación cacheada expira
CACHE_TTL_DAYS=30
# Idioma por defecto: es | en
DEFAULT_LANGUAGE=es
