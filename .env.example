# ─────────────────────────────────────────────────────────────
#  VeritasAgent — plantilla de variables de entorno
#  Copia este archivo a .env y rellena los valores reales.
#  NUNCA subas el .env real al repositorio.
# ─────────────────────────────────────────────────────────────

# ─── Vertex AI (Gemini) ──────────────────────────────────────
# La autenticación NO usa API key (la organización las bloquea).
# Se hace con Application Default Credentials (ADC). Antes de correr:
#     gcloud auth login
#     gcloud auth application-default login
#     gcloud config set project <tu-project-id>
#     gcloud auth application-default set-quota-project <tu-project-id>
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# Modelos
MODEL_NAME=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# ─── Agent Engine (cuando esté desplegado, Fase 6) ───────────
AGENT_ENGINE_ID=

# ─── Bright Data MCP (scraping + búsqueda) ───────────────────
# Servidor oficial: @brightdata/mcp (npx)
BRIGHTDATA_API_TOKEN=
# Zona de desbloqueo web (por defecto "mcp_unlocker"; cambia si la creaste con otro nombre)
BRIGHTDATA_WEB_UNLOCKER_ZONE=mcp_unlocker

# ─── Elasticsearch (🟢 TRACK PARTNER del reto: triage + memoria) ──
# Servidor MCP oficial: @elastic/mcp-server-elasticsearch (npx)
# Usa Cloud ID si tienes Elastic Cloud, o URL si es self-hosted.
ELASTIC_CLOUD_ID=
ELASTIC_URL=https://localhost:9200
ELASTIC_API_KEY=
ELASTIC_INDEX=verified_claims

# ─── Arize Phoenix (observabilidad) ──────────────────────────
API_KEY_PHOENIX=

# ─── API backend ─────────────────────────────────────────────
API_URL=http://localhost:8000

# ─── Configuración del agente ────────────────────────────────
# Umbrales del triage (ver PLAN.md §3)
TRIAGE_EARLY_EXIT_THRESHOLD=0.92
TRIAGE_EVIDENCE_THRESHOLD=0.75
# Días tras los cuales una verificación cacheada expira
CACHE_TTL_DAYS=30
# Idioma por defecto: es | en
DEFAULT_LANGUAGE=es
