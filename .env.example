# ─────────────────────────────────────────────────────────────
#  VeritasAgent — plantilla de variables de entorno
#  Copia este archivo a .env y rellena los valores reales.
#  NUNCA subas el .env real al repositorio.
# ─────────────────────────────────────────────────────────────

# ─── Gemini / Vertex AI ──────────────────────────────────────
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Pon "True" para usar Vertex AI; "False" para usar la API de Gemini directa
GOOGLE_GENAI_USE_VERTEXAI=True

# Modelo de razonamiento del agente
MODEL_NAME=gemini-2.5-flash
# Modelo para generar embeddings del triage
EMBEDDING_MODEL=text-embedding-004

# ─── Bright Data MCP ─────────────────────────────────────────
BRIGHTDATA_API_KEY=

# ─── Elastic Cloud (MCP + memoria) ───────────────────────────
ELASTIC_CLOUD_ID=
ELASTIC_API_KEY=
ELASTIC_INDEX=verified_claims

# ─── Configuración del agente ────────────────────────────────
# Umbrales del triage (ver PLAN.md §3)
TRIAGE_EARLY_EXIT_THRESHOLD=0.92
TRIAGE_EVIDENCE_THRESHOLD=0.75
# Días tras los cuales una verificación cacheada expira
CACHE_TTL_DAYS=30
# Idioma por defecto: es | en
DEFAULT_LANGUAGE=es
