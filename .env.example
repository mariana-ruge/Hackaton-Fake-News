# ─────────────────────────────────────────────────────────────
#  Blacklight Expose — plantilla de variables de entorno
#  Copia este archivo a .env y rellena los valores reales.
#  NUNCA subas el .env real al repositorio.
# ─────────────────────────────────────────────────────────────

# ─── Gemini — elige UN modo de autenticación ─────────────────
#
# +----------------------------------------------------------------------+
# |  Modo A · Vertex AI (ADC)  - recomendado para org + produccion       |
# |  Se autentica con `gcloud auth application-default login`. Requiere  |
# |  proyecto Google Cloud y API Vertex AI habilitada. Necesario para    |
# |  desplegar a Vertex AI Agent Engine.                                 |
# +----------------------------------------------------------------------+
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
#
# Pre-vuelo (una vez):
#   gcloud auth login
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project <tu-project-id>
#
# +----------------------------------------------------------------------+
# |  Modo B · API key directa (AI Studio)  - facil para devs / jueces    |
# |  No requiere gcloud. Cambia GOOGLE_GENAI_USE_VERTEXAI a "False" y    |
# |  pon tu API key (https://aistudio.google.com/app/apikey).            |
# |  Limitaciones:                                                       |
# |    * No se puede desplegar a Agent Engine (solo local).              |
# |    * Firestore queda desactivado salvo que tambien definas un        |
# |      GOOGLE_CLOUD_PROJECT valido con permisos.                       |
# +----------------------------------------------------------------------+
# GOOGLE_GENAI_USE_VERTEXAI=False
# GOOGLE_API_KEY=

# Modelos (validos en ambos modos)
MODEL_NAME=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# ─── Agent Engine (cuando esté desplegado, Fase 6) ───────────
AGENT_ENGINE_ID=
# Bucket GCS para artefactos de staging del deploy (ej. gs://mi-proyecto-agent-engine)
AGENT_ENGINE_STAGING_BUCKET=

# ─── Bright Data MCP (scraping + búsqueda) ───────────────────
# Servidor oficial: @brightdata/mcp (npx)
BRIGHTDATA_API_TOKEN=
# Zona de desbloqueo web (por defecto "mcp_unlocker"; cambia si la creaste con otro nombre)
BRIGHTDATA_WEB_UNLOCKER_ZONE=mcp_unlocker
# (Opcional) Scraping Browser por WebSocket — respaldo legado que usa
# scraper.py si el MCP falla. Puede dejarse vacío.
BRIGHT_DATA_WS_URL=

# ─── Elasticsearch (🟢 TRACK PARTNER del reto: triage + memoria) ──
# Servidor MCP oficial: @elastic/mcp-server-elasticsearch (npx)
# Usa Cloud ID si tienes Elastic Cloud, o URL si es self-hosted.
ELASTIC_CLOUD_ID=
ELASTIC_URL=https://localhost:9200
ELASTIC_API_KEY=
ELASTIC_INDEX=verified_claims

# ─── Arize Phoenix (telemetría + MCP bonus partner) ──────────
# La misma clave habilita la telemetría OpenTelemetry Y el Phoenix MCP.
API_KEY_PHOENIX=
PHOENIX_BASE_URL=https://app.phoenix.arize.com

# ─── API backend ─────────────────────────────────────────────
API_URL=http://localhost:8000

# ─── Configuración del agente ────────────────────────────────
# Umbrales del triage (ver PLAN.md §3 y ADR-0007)
TRIAGE_EARLY_EXIT_THRESHOLD=0.92
TRIAGE_EVIDENCE_THRESHOLD=0.75
# Cuántos claims disparan búsqueda web en cross-reference (latencia/cuota)
CROSS_REFERENCE_MAX_SEARCHES=3
# Días tras los cuales una verificación cacheada expira
CACHE_TTL_DAYS=30
# Idioma por defecto: es | en
DEFAULT_LANGUAGE=es
